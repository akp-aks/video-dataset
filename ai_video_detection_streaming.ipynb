    {
      "cell_type": "markdown",
      "id": "title",
      "metadata": {},
      "source": [
        "# AI Video Detection - Streaming Pipeline\n",
        "\n",
        "**Workflow:**\n",
        "1. Load CSV from GitHub\n",
        "2. For each video:\n",
        "   - Download (temporary)\n",
        "   - Extract features\n",
        "   - Delete immediately\n",
        "3. Save features (CSV)\n",
        "4. Split 80% train : 20% test\n",
        "5. Train 6 models\n",
        "\n",
        "**Zero Storage** - Videos deleted after feature extraction"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "imports",
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "import sys\n",
        "import cv2\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import requests\n",
        "import warnings\n",
        "import tempfile\n",
        "from io import BytesIO\n",
        "from pathlib import Path\n",
        "\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, roc_auc_score, confusion_matrix\n",
        "from sklearn.ensemble import ExtraTreesClassifier, RandomForestClassifier\n",
        "\n",
        "from xgboost import XGBClassifier\n",
        "from catboost import CatBoostClassifier\n",
        "from ngboost import NGBClassifier\n",
        "from pytorch_tabnet.tab_model import TabNetClassifier\n",
        "\n",
        "import shap\n",
        "from lime.lime_tabular import LimeTabularExplainer\n",
        "\n",
        "print(\"✓ All imports successful\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "config",
      "metadata": {},
      "outputs": [],
      "source": [
        "# =========================\n",
        "# CONFIGURATION\n",
        "# =========================\n",
        "\n",
        "# GitHub CSV URL\n",
        "GITHUB_CSV_URL = \"https://raw.githubusercontent.com/akp-aks/video-dataset/main/GenVidBench_15k_WITH_LINKS.csv\"\n",
        "LOCAL_CSV = \"GenVidBench_15k_WITH_LINKS.csv\"\n",
        "\n",
        "# Output folders\n",
        "FEATURE_FOLDER = \"features\"\n",
        "RESULT_FOLDER = \"results\"\n",
        "FEATURE_FILE = os.path.join(FEATURE_FOLDER, \"video_features.csv\")\n",
        "RESULTS_FILE = os.path.join(RESULT_FOLDER, \"model_results.csv\")\n",
        "\n",
        "# Video sampling\n",
        "MAX_VIDEOS = 1000  # 500 real + 500 AI\n",
        "FRAMES_PER_VIDEO = 10\n",
        "\n",
        "# Train/Test split\n",
        "TRAIN_RATIO = 0.8  # 80% train, 20% test\n",
        "TEST_RATIO = 0.2\n",
        "\n",
        "# Create folders\n",
        "os.makedirs(FEATURE_FOLDER, exist_ok=True)\n",
        "os.makedirs(RESULT_FOLDER, exist_ok=True)\n",
        "\n",
        "print(f\"Config:\")\n",
        "print(f\"  Max videos: {MAX_VIDEOS}\")\n",
        "print(f\"  Frames per video: {FRAMES_PER_VIDEO}\")\n",
        "print(f\"  Train/Test split: {TRAIN_RATIO}/{TEST_RATIO}\")\n",
        "print(f\"  Feature file: {FEATURE_FILE}\")\n",
        "print(f\"  Results file: {RESULTS_FILE}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "load_csv",
      "metadata": {},
      "outputs": [],
      "source": [
        "# =========================\n",
        "# STEP 1: LOAD CSV FROM GITHUB\n",
        "# =========================\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"STEP 1: LOAD CSV\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "try:\n",
        "    print(f\"Loading from GitHub: {GITHUB_CSV_URL}\")\n",
        "    df = pd.read_csv(GITHUB_CSV_URL)\n",
        "    print(f\"✓ Loaded from GitHub\")\n",
        "except Exception as e:\n",
        "    print(f\"GitHub failed: {e}\")\n",
        "    print(f\"Trying local: {LOCAL_CSV}\")\n",
        "    if os.path.exists(LOCAL_CSV):\n",
        "        df = pd.read_csv(LOCAL_CSV)\n",
        "        print(f\"✓ Loaded from local\")\n",
        "    else:\n",
        "        raise FileNotFoundError(f\"CSV not found at {LOCAL_CSV} or GitHub\")\n",
        "\n",
        "# Verify columns\n",
        "required = ['video_id', 'download_link', 'type', 'category', 'duration_seconds']\n",
        "missing = [c for c in required if c not in df.columns]\n",
        "if missing:\n",
        "    raise ValueError(f\"Missing columns: {missing}\")\n",
        "\n",
        "# Add label\n",
        "df['label'] = df['type'].map({'real': 0, 'ai_generated': 1})\n",
        "df = df.dropna(subset=['label']).copy()\n",
        "df['label'] = df['label'].astype(int)\n",
        "\n",
        "print(f\"\\nDataset info:\")\n",
        "print(f\"  Total rows: {len(df)}\")\n",
        "print(f\"  Real videos: {(df['label']==0).sum()}\")\n",
        "print(f\"  AI videos: {(df['label']==1).sum()}\")\n",
        "print(f\"\\nFirst rows:\")\n",
        "print(df[['video_id', 'type', 'label']].head())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "select_balanced",
      "metadata": {},
      "outputs": [],
      "source": [
        "# =========================\n",
        "# STEP 2: SELECT BALANCED SAMPLE\n",
        "# =========================\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"STEP 2: SELECT BALANCED SAMPLE\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "real_videos = df[df['label'] == 0].sample(n=500, random_state=42)\n",
        "ai_videos = df[df['label'] == 1].sample(n=500, random_state=42)\n",
        "selected_df = pd.concat([real_videos, ai_videos]).sample(frac=1, random_state=42).reset_index(drop=True)\n",
        "\n",
        "print(f\"Selected:\")\n",
        "print(f\"  Real: {len(real_videos)}\")\n",
        "print(f\"  AI: {len(ai_videos)}\")\n",
        "print(f\"  Total: {len(selected_df)}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "feature_extraction",
      "metadata": {},
      "outputs": [],
      "source": [
        "# =========================\n",
        "# STEP 3: FEATURE EXTRACTION FUNCTION\n",
        "# =========================\n",
        "\n",
        "def extract_features_from_video(video_url, frames_to_extract=FRAMES_PER_VIDEO):\n",
        "    \"\"\"\n",
        "    STREAMING APPROACH:\n",
        "    1. Download video to temp file\n",
        "    2. Extract features\n",
        "    3. Delete temp file\n",
        "    4. Return features dict\n",
        "    \"\"\"\n",
        "    \n",
        "    temp_file = None\n",
        "    \n",
        "    try:\n",
        "        # Step 1: DOWNLOAD to temp file\n",
        "        print(f\"  → Downloading...\", end=\"\")\n",
        "        response = requests.get(video_url, timeout=30)\n",
        "        \n",
        "        with tempfile.NamedTemporaryFile(suffix='.mp4', delete=False) as tmp:\n",
        "            tmp.write(response.content)\n",
        "            temp_file = tmp.name\n",
        "        \n",
        "        print(f\" Extracting...\", end=\"\")\n",
        "        \n",
        "        # Step 2: EXTRACT FEATURES\n",
        "        cap = cv2.VideoCapture(temp_file)\n",
        "        \n",
        "        if not cap.isOpened():\n",
        "            return None\n",
        "        \n",
        "        frames = []\n",
        "        frame_count = 0\n",
        "        \n",
        "        # Read frames\n",
        "        while True:\n",
        "            ret, frame = cap.read()\n",
        "            if not ret:\n",
        "                break\n",
        "            if frame_count < frames_to_extract:\n",
        "                frames.append(frame)\n",
        "            frame_count += 1\n",
        "        \n",
        "        cap.release()\n",
        "        \n",
        "        if len(frames) == 0:\n",
        "            return None\n",
        "        \n",
        "        # Extract features from frames\n",
        "        features = {}\n",
        "        \n",
        "        for i, frame in enumerate(frames):\n",
        "            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n",
        "            \n",
        "            # Brightness\n",
        "            features[f'brightness_{i}'] = np.mean(gray)\n",
        "            \n",
        "            # Contrast\n",
        "            features[f'contrast_{i}'] = np.std(gray)\n",
        "            \n",
        "            # Sharpness (Laplacian variance)\n",
        "            laplacian = cv2.Laplacian(gray, cv2.CV_64F)\n",
        "            features[f'sharpness_{i}'] = np.var(laplacian)\n",
        "            \n",
        "            # Color channels\n",
        "            features[f'color_r_{i}'] = np.var(frame[:,:,2])\n",
        "            features[f'color_g_{i}'] = np.var(frame[:,:,1])\n",
        "            features[f'color_b_{i}'] = np.var(frame[:,:,0])\n",
        "        \n",
        "        # Aggregate features\n",
        "        for prefix in ['brightness', 'contrast', 'sharpness', 'color_r', 'color_g', 'color_b']:\n",
        "            values = [features[k] for k in features if k.startswith(prefix)]\n",
        "            if values:\n",
        "                features[f'{prefix}_mean'] = np.mean(values)\n",
        "                features[f'{prefix}_std'] = np.std(values)\n",
        "                features[f'{prefix}_max'] = np.max(values)\n",
        "                features[f'{prefix}_min'] = np.min(values)\n",
        "        \n",
        "        # Remove individual frame features\n",
        "        for i in range(frames_to_extract):\n",
        "            for prefix in ['brightness', 'contrast', 'sharpness', 'color_r', 'color_g', 'color_b']:\n",
        "                features.pop(f'{prefix}_{i}', None)\n",
        "        \n",
        "        print(f\" Deleting...\", end=\"\")\n",
        "        \n",
        "        # Step 3: DELETE temp file\n",
        "        if temp_file and os.path.exists(temp_file):\n",
        "            os.remove(temp_file)\n",
        "            temp_file = None\n",
        "        \n",
        "        print(f\" ✓\")\n",
        "        return features\n",
        "    \n",
        "    except Exception as e:\n",
        "        print(f\" ✗ ({str(e)[:30]}...)\") \n",
        "        return None\n",
        "    \n",
        "    finally:\n",
        "        # Ensure temp file is deleted\n",
        "        if temp_file and os.path.exists(temp_file):\n",
        "            try:\n",
        "                os.remove(temp_file)\n",
        "            except:\n",
        "                pass"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "extract_all",
      "metadata": {},
      "outputs": [],
      "source": [
        "# =========================\n",
        "# STEP 4: PROCESS EACH VIDEO\n",
        "# =========================\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"STEP 3: EXTRACT FEATURES (ONE VIDEO AT A TIME)\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "all_features = []\n",
        "successful = 0\n",
        "failed = 0\n",
        "\n",
        "for idx, row in selected_df.iterrows():\n",
        "    video_id = row['video_id']\n",
        "    url = row['download_link']\n",
        "    label = row['label']\n",
        "    video_type = row['type']\n",
        "    \n",
        "    print(f\"[{idx+1}/{len(selected_df)}] {video_id}\", end=\"\")\n",
        "    \n",
        "    # Extract features (downloads, extracts, deletes)\n",
        "    features = extract_features_from_video(url, FRAMES_PER_VIDEO)\n",
        "    \n",
        "    if features:\n",
        "        features['video_id'] = video_id\n",
        "        features['label'] = label\n",
        "        features['type'] = video_type\n",
        "        all_features.append(features)\n",
        "        successful += 1\n",
        "    else:\n",
        "        failed += 1\n",
        "\n",
        "print(f\"\\n\\nExtraction complete:\")\n",
        "print(f\"  Successful: {successful}\")\n",
        "print(f\"  Failed: {failed}\")\n",
        "\n",
        "# Create features dataframe\n",
        "features_df = pd.DataFrame(all_features)\n",
        "\n",
        "print(f\"\\nFeatures DataFrame:\")\n",
        "print(f\"  Shape: {features_df.shape}\")\n",
        "print(f\"  Columns: {features_df.shape[1]}\")\n",
        "print(f\"\\nFirst 3 rows:\")\n",
        "print(features_df.head(3))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "save_features",
      "metadata": {},
      "outputs": [],
      "source": [
        "# =========================\n",
        "# STEP 5: SAVE FEATURES\n",
        "# =========================\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"STEP 4: SAVE FEATURES\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "features_df.to_csv(FEATURE_FILE, index=False)\n",
        "print(f\"✓ Saved: {FEATURE_FILE}\")\n",
        "print(f\"  Size: {features_df.shape[0]} videos × {features_df.shape[1]} features\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "split_train_test",\n",
      "metadata": {},
      "outputs": [],
      "source": [
        "# =========================\n",
        "# STEP 6: SPLIT 80:20 TRAIN:TEST\n",
        "# =========================\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"STEP 5: TRAIN/TEST SPLIT (80:20)\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "# Prepare data\n",
        "X = features_df.drop(['video_id', 'label', 'type'], axis=1)\n",
        "y = features_df['label']\n",
        "\n",
        "# Split 80:20\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y,\n",
        "    test_size=TEST_RATIO,\n",
        "    train_size=TRAIN_RATIO,\n",
        "    random_state=42,\n",
        "    stratify=y\n",
        ")\n",
        "\n",
        "# Scale\n",
        "scaler = StandardScaler()\n",
        "X_train_scaled = scaler.fit_transform(X_train)\n",
        "X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "print(f\"\\nTrain/Test Split:\")\n",
        "print(f\"  Total samples: {len(X)}\")\n",
        "print(f\"  Train set: {len(X_train)} ({TRAIN_RATIO*100:.0f}%)\")\n",
        "print(f\"    Real: {(y_train==0).sum()}\")\n",
        "print(f\"    AI: {(y_train==1).sum()}\")\n",
        "print(f\"  Test set: {len(X_test)} ({TEST_RATIO*100:.0f}%)\")\n",
        "print(f\"    Real: {(y_test==0).sum()}\")\n",
        "print(f\"    AI: {(y_test==1).sum()}\")\n",
        "print(f\"\\nFeatures: {X.shape[1]}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "train_models",\n",
      "metadata": {},
      "outputs": [],
      "source": [
        "# =========================\n",
        "# STEP 7: TRAIN 6 MODELS\n",
        "# =========================\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"STEP 6: TRAIN 6 MODELS\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "models = {}\n",
        "predictions = {}\n",
        "probabilities = {}\n",
        "\n",
        "# 1. XGBoost\n",
        "print(\"\\n[1/6] XGBoost\")\n",
        "xgb = XGBClassifier(n_estimators=300, learning_rate=0.1, max_depth=7, random_state=42, eval_metric='logloss')\n",
        "xgb.fit(X_train, y_train, verbose=False)\n",
        "predictions['XGBoost'] = xgb.predict(X_test).astype(int)\n",
        "probabilities['XGBoost'] = xgb.predict_proba(X_test)[:, 1]\n",
        "models['xgboost'] = xgb\n",
        "print(\"✓\")\n",
        "\n",
        "# 2. CatBoost\n",
        "print(\"[2/6] CatBoost\")\n",
        "cb = CatBoostClassifier(iterations=300, learning_rate=0.1, random_state=42, verbose=False)\n",
        "cb.fit(X_train, y_train, verbose=False)\n",
        "predictions['CatBoost'] = cb.predict(X_test).astype(int)\n",
        "probabilities['CatBoost'] = cb.predict_proba(X_test)[:, 1]\n",
        "models['catboost'] = cb\n",
        "print(\"✓\")\n",
        "\n",
        "# 3. Extra Trees\n",
        "print(\"[3/6] Extra Trees\")\n",
        "et = ExtraTreesClassifier(n_estimators=300, max_depth=20, random_state=42, n_jobs=-1)\n",
        "et.fit(X_train, y_train)\n",
        "predictions['Extra Trees'] = et.predict(X_test).astype(int)\n",
        "probabilities['Extra Trees'] = et.predict_proba(X_test)[:, 1]\n",
        "models['extratrees'] = et\n",
        "print(\"✓\")\n",
        "\n",
        "# 4. Random Forest\n",
        "print(\"[4/6] Random Forest\")\n",
        "rf = RandomForestClassifier(n_estimators=300, max_depth=20, random_state=42, n_jobs=-1)\n",
        "rf.fit(X_train, y_train)\n",
        "predictions['Random Forest'] = rf.predict(X_test).astype(int)\n",
        "probabilities['Random Forest'] = rf.predict_proba(X_test)[:, 1]\n",
        "models['rf'] = rf\n",
        "print(\"✓\")\n",
        "\n",
        "# 5. TabNet\n",
        "print(\"[5/6] TabNet\")\n",
        "tabnet = TabNetClassifier(verbose=0, random_state=42)\n",
        "tabnet.fit(X_train_scaled, y_train, eval_set=[(X_test_scaled, y_test)], patience=10, max_epochs=100)\n",
        "predictions['TabNet'] = tabnet.predict(X_test_scaled).astype(int)\n",
        "probabilities['TabNet'] = tabnet.predict_proba(X_test_scaled)[:, 1]\n",
        "models['tabnet'] = tabnet\n",
        "print(\"✓\")\n",
        "\n",
        "# 6. NGBoost\n",
        "print(\"[6/6] NGBoost\")\n",
        "ngb = NGBClassifier(n_estimators=300, learning_rate=0.03, random_state=42, verbose=False)\n",
        "ngb.fit(X_train_scaled, y_train)\n",
        "predictions['NGBoost'] = np.asarray(ngb.predict(X_test_scaled)).astype(int)\n",
        "probabilities['NGBoost'] = ngb.predict_proba(X_test_scaled)[:, 1]\n",
        "models['ngboost'] = ngb\n",
        "print(\"✓\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "evaluate",\n",
      "metadata": {},
      "outputs": [],
      "source": [
        "# =========================\n",
        "# STEP 8: EVALUATE MODELS\n",
        "# =========================\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"STEP 7: MODEL EVALUATION\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "results = []\n",
        "\n",
        "for name in predictions:\n",
        "    pred = predictions[name]\n",
        "    prob = probabilities[name]\n",
        "    \n",
        "    row = {\n",
        "        'Algorithm': name,\n",
        "        'Accuracy': accuracy_score(y_test, pred),\n",
        "        'Precision': precision_score(y_test, pred, zero_division=0),\n",
        "        'Recall': recall_score(y_test, pred, zero_division=0),\n",
        "        'F1_Score': f1_score(y_test, pred, zero_division=0),\n",
        "        'ROC_AUC': roc_auc_score(y_test, prob)\n",
        "    }\n",
        "    results.append(row)\n",
        "\n",
        "results_df = pd.DataFrame(results).sort_values('Accuracy', ascending=False).reset_index(drop=True)\n",
        "\n",
        "print(\"\\n\" + results_df.to_string(index=False))\n",
        "\n",
        "# Save results\n",
        "results_df.to_csv(RESULTS_FILE, index=False)\n",
        "print(f\"\\n✓ Results saved: {RESULTS_FILE}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "explanations",\n",
      "metadata": {},
      "outputs": [],
      "source": [
        "# =========================\n",
        "# STEP 9: EXPLANATIONS\n",
        "# =========================\n",
        "\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"STEP 8: GENERATE EXPLANATIONS\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "# SHAP\n",
        "try:\n",
        "    print(\"\\nGenerating SHAP...\")\n",
        "    explainer = shap.TreeExplainer(models['xgboost'])\n",
        "    shap_values = explainer.shap_values(X_test)\n",
        "    shap.summary_plot(shap_values, X_test, show=True)\n",
        "    print(\"✓ SHAP generated\")\nexcept Exception as e:\n",
        "    print(f\"SHAP error: {e}\")\n",
        "\n",
        "# LIME\n",
        "try:\n",
        "    print(\"\\nGenerating LIME...\")\n",
        "    explainer = LimeTabularExplainer(\n",
        "        X_test.to_numpy(),\n",
        "        feature_names=X_test.columns.tolist(),\n",
        "        class_names=['Real', 'AI-Generated'],\n",
        "        mode='classification',\n",
        "        random_state=42\n",
        "    )\n",
        "    explanation = explainer.explain_instance(\n",
        "        X_test.iloc[0].to_numpy(),\n",
        "        models['xgboost'].predict_proba,\n",
        "        num_features=10\n",
        "    )\n",
        "    \n",
        "    print(\"Top features:\")\n",
        "    for feature, weight in explanation.as_list():\n",
        "        print(f\"  {feature}: {weight:.6f}\")\n",
        "    \n",
        "    explanation.save_to_file(os.path.join(RESULT_FOLDER, 'lime_explanation.html'))\n",
        "    print(\"✓ LIME saved\")\nexcept Exception as e:\n",
